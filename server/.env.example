# Local dev only — copy relevant lines into server/.env. In production on
# Hostinger, these are set as Node.js environment variables in hPanel
# instead of a committed/uploaded .env file (PORT is provided by Hostinger
# automatically and doesn't need to be set there).
PORT=5000
# Set to the real production origin(s) once the domain moves (e.g.
# https://www.adtextile.com), comma-separated if serving more than one.
CLIENT_URL=http://localhost:5173

MAIL_MODE=log

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAIL_FROM=

# Sales Enquiry form (src/components/contact/EnquiryForm.jsx)
SALES_MAIL_TO=
SALES_MAIL_CC=

# Request a Quote form (src/components/contact/QuoteForm.jsx)
QUOTATION_MAIL_TO=
QUOTATION_MAIL_CC=

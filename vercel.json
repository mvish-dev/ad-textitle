{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install && npm install --prefix server",
  "redirects": [
    { "source": "/living-linen", "destination": "/products", "permanent": true },
    { "source": "/heritage-bed-linen", "destination": "/products", "permanent": true },
    { "source": "/kitchen-linen", "destination": "/products", "permanent": true },
    { "source": "/table-linen", "destination": "/products", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

# Frontend (Vite) environment variables — copy relevant lines into .env.local
# (already gitignored via *.local) for local development.

# Local dev only: the backend runs separately on its own port (see
# server/.env.example -> PORT), so requests need an absolute URL.
# On Vercel, leave this unset — the frontend and API share one deployment,
# so the code falls back to a same-origin relative "/api/contact" call.
VITE_API_URL=http://localhost:5000

VITE_MAINTENANCE_MODE=false
